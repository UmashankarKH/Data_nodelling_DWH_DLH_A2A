# Copy this file to .env  (setup.py does it for you). NEVER share or commit .env: it holds your key.

# Pick ONE provider: openrouter | nvidia | ollama | azure | mock
LLM_PROVIDER=openrouter

# --- OpenRouter (free open models, key from https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Optional: choose another model. Run `python check_llm.py --list` to see ids (free ones end in :free)
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- NVIDIA (free open models, key from https://build.nvidia.com) ---
NVIDIA_API_KEY=
# LLM_MODEL=meta/llama-3.3-70b-instruct

# --- Ollama (model on your laptop: `ollama pull qwen2.5-coder:7b`) ---
# LLM_MODEL=qwen2.5-coder:7b

# --- Microsoft Foundry model deployment (trainer demo) ---
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<your deployment name>

# Optional: skip the second model call that writes the plain-English summary (saves free-tier requests)
# AGENT_SUMMARY=off
