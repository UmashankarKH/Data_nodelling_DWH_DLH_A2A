le;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c31"><mxGeometry x="0" y="78" width="330" height="24" as="geometry"/></mxCell><mxCell id="c36" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;list_price&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;number&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#F7F7F7;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c31"><mxGeometry x="0" y="102" width="330" height="24" as="geometry"/></mxCell><mxCell id="c37" value="has versions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="placed by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.18;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="is a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;PK primary key · FK foreign key&lt;br&gt;Crow's foot = many, bar = exactly one, circle = optional.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this shape hurts analysis&lt;/b&gt;&lt;br&gt;Revenue by city needs four joins, and the city depends on the sale date. That is the reason the warehouse reshapes it into a star." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fillColor=#FFFDE7;strokeColor=#F9A825;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="400" height="170" as="geometry"/></mxCell><mxCell id="c42" value="Grain check: ORDER_LINE has one row per product on an order. Mixing it with order level facts double counts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;spacing=8;rounded=1;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="300" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 Data warehouse (star)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Data warehouse: star schema with one fact table and three dimensions (Labs 2 and 3)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Built in DuckDB (warehouse.duckdb). Dimensions answer who, what, when. The fact table holds the numbers." style="text