rflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c26"><mxGeometry x="0" y="126" width="300" height="24" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="540" y="620" width="380" height="222" as="geometry"/></mxCell><mxCell id="c34" value="dim_customer (SCD Type 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#202124;align=center;verticalAlign=middle;" vertex="1" parent="c33"><mxGeometry x="0" y="0" width="380" height="30" as="geometry"/></mxCell><mxCell id="c35" value='&lt;font color="#B71C1C"&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;customer_key&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;int, one per VERSION&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="30" width="380" height="24" as="geometry"/></mxCell><mxCell id="c36" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;email&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;text&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#F7F7F7;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="54" width="380" height="24" as="geometry"/></mxCell><mxCell id="c37" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;full_name&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;text&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="78" width="380" height="24" as="geometry"/></mxCell><mxCell id="c38" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;city&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;text&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#F7F7F7;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="102" width="380" height="24" as="geometry"/></mxCell><mxCell id="c39" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;tier&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;text&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="126" width="380" height="24" as="geometry"/></mxCell><mxCell id="c40" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;valid_from&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;date&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#F7F7F7;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="150" width="380" height="24" as="geometry"/></mxCell><mxCell id="c41" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;valid_to&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;date&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="174" width="380" height="24" as="geometry"/></mxCell><mxCell id="c42" value='&lt;font color="#9E9E9E"&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;is_current&lt;font color="#9E9E9E"&gt;&amp;nbsp;&amp;nbsp;bool&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=#F7F7F7;align=left;verticalAlign=middle;spacingLeft=10;overflow=hidden;rotatable=0;fontSize=12;fontColor=#202124;" vertex="1" parent="c33"><mxGeometry x="0" y="198" width="380" height="24" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.275;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.34;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;Grain&lt;/b&gt;&lt;br&gt;One row per order line: one product on one order.&lt;br&gt;Say it aloud before writing any SQL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fillColor=#FFFDE7;strokeColor=#F9A825;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="340" height="100" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;How it is built&lt;/b&gt;&lt;br&gt;raw files, then stg_sales (clean, de-duplicate, apply rules), then the dimensions, then the fact." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#9AA0A6;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="90" y="120" width="380" height="100" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Never drop a row&lt;/b&gt;&lt;br&gt;dim_product and dim_customer each have an Unknown member with key -1, so an orphan sale (SKU999, a walk-in) stays visible." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#9AA0A6;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="300" height="130" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;SCD Type 2 rule&lt;/b&gt;&lt;br&gt;Each customer version gets its own surrogate key. fact_sales picks the version where sold_on is between valid_from and valid_to, so May sales stay in the city the customer lived in during May." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fillColor=#FFFDE7;strokeColor=#F9A825;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="980" y="640" width="420" height="130" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Business rules in the fact&lt;/b&gt;&lt;br&gt;gross_amount = qty × unit_price&lt;br&gt;net_amount = gross × (1 − discount_pct / 100)&lt;br&gt;cancelled orders excluded, returns are negative qty" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#9AA0A6;spacing=10;rounded=1;" vertex="1" parent="1"><mxGeometry x="90" y="640" width="380" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 Data lakehouse (medallion)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Data lakehouse: bronze, silver and gold Delta tables on one storage layer (Lab 4)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Same data, three levels of trust. Never edit bronze. Fix problems once, in silver. Serve questions from gold." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Sources" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="230" height="560" as="geometry"/></mxCell><mxCell id="c5" value="POS sales CSV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="50" width="190" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Web orders JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Products CSV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="290" width="190" height="70" as="geometry"/></mxCell><mxCell id="c8" value="CRM customers CSV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="410" width="190" height="70" as="geometry"/></mxCell><mxCell id="c9" value="BRONZE: as received" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F6E3D0;strokeColor=#A5622B;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="320" height="560" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;bronze/pos_sales&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;all columns as text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E3D0;strokeColor=#A5622B;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c9"><mxGeometry x="20" y="50" width="280" height="76" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;bronze/web_orders&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;items kept as raw JSON text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E3D0;strokeColor=#A5622B;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c9"><mxGeometry x="20" y="150" width="280" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;bronze/products&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;all columns as text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E3D0;strokeColor=#A5622B;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c9"><mxGeometry x="20" y="250" width="280" height="76" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;bronze/crm_customers&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;all columns as text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6E3D0;strokeColor=#A5622B;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c9"><mxGeometry x="20" y="350" width="280" height="76" as="geometry"/></mxCell><mxCell id="c14" value="adds _source_file and _ingested_at to every table" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F6368;" vertex="1" parent="c9"><mxGeometry x="20" y="465" width="280" height="40" as="geometry"/></mxCell><mxCell id="c15" value="SILVER: cleaned and trusted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="320" height="560" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;silver/sales&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;typed dates, lower-case emails,&lt;br&gt;de-duplicated on order_id + sku,&lt;br&gt;cancelled kept with status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c15"><mxGeometry x="20" y="50" width="280" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;silver/products&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;category casing fixed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c15"><mxGeometry x="20" y="170" width="280" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;silver/customers_history&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;one row per customer version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c15"><mxGeometry x="20" y="290" width="280" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Time travel demo&lt;/b&gt;&lt;br&gt;DELETE web rows: version 1&lt;br&gt;read version 0: still intact&lt;br&gt;RESTORE: version 2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;spacing=8;rounded=1;" vertex="1" parent="c15"><mxGeometry x="20" y="420" width="280" height="110" as="geometry"/></mxCell><mxCell id="c20" value="GOLD: ready for questions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFF3C4;strokeColor=#C79100;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="320" height="560" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;gold/fact_sales&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;one row per order line, net_amount&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF3C4;strokeColor=#C79100;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c20"><mxGeometry x="20" y="50" width="280" height="76" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;gold/dim_customer&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;SCD Type 2, valid_from / valid_to&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF3C4;strokeColor=#C79100;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c20"><mxGeometry x="20" y="150" width="280" height="76" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;gold/dim_product&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;clean categories, Unknown member&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF3C4;strokeColor=#C79100;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c20"><mxGeometry x="20" y="250" width="280" height="76" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;gold/dim_date&lt;/b&gt;&lt;br&gt;&lt;font color='#5F6368'&gt;calendar attributes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF3C4;strokeColor=#C79100;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c20"><mxGeometry x="20" y="350" width="280" height="76" as="geometry"/></mxCell><mxCell id="c25" value="Consumers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1540" y="120" width="260" height="560" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Sales Insights agent&lt;/b&gt;&lt;br&gt;over A2A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c25"><mxGeometry x="20" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Dashboards and BI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c25"><mxGeometry x="20" y="170" width="220" height="80" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;ML features&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c25"><mxGeometry x="20" y="290" width="220" height="80" as="geometry"/></mxCell><mxCell id="c29" value="land as-is" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=2;fontSize=12;fontColor=#202124;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="clean + type" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=2;fontSize=12;fontColor=#202124;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=2;fontSize=12;fontColor=#202124;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="read gold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=2;fontSize=12;fontColor=#202124;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Storage layer&lt;/b&gt;: Parquet files + _delta_log transaction log. Gives ACID writes, updates and deletes, schema enforcement, time travel and restore. Lab: local folders. Azure: OneLake or ADLS." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="340" y="720" width="1120" height="70" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;On Azure&lt;/b&gt;: Fabric Lakehouse. Files hold the raw data (bronze). Tables hold silver and gold as Delta. The SQL analytics endpoint serves T-SQL to agents and BI." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1F0FF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="340" y="810" width="1120" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 Azure Foundry deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Trainer demo: everything on Azure. Foundry hosts the model and agents, Container Apps hosts our A2A agent" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1700" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Dashed = optional or untested path. Learners do not use this; they run SETUP.md with OpenRouter, NVIDIA or Ollama." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1700" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Trainer laptop or Cloud Shell" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;foundry_a2a_agent.py&lt;/b&gt;&lt;br&gt;creates the CEO assistant agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="50" width="260" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;a2a_client.py&lt;/b&gt;&lt;br&gt;calls the Container App directly&lt;br&gt;(fallback demo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="440" width="260" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;foundry_function_agent.py&lt;/b&gt;&lt;br&gt;runs run_sql when asked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="290" width="260" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Microsoft Foundry project" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E1F0FF;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="540" height="560" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;CEO assistant agent&lt;/b&gt;&lt;br&gt;prompt agent with the A2A tool" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1F0FF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c8"><mxGeometry x="30" y="50" width="480" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;A2A project connection&lt;/b&gt; (freshkart-a2a)&lt;br&gt;points at the Container App's https address" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1F0FF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c8"><mxGeometry x="30" y="170" width="480" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Sales Insights agent&lt;/b&gt;&lt;br&gt;prompt agent with function tool run_sql" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1F0FF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c8"><mxGeometry x="30" y="290" width="480" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Model deployment&lt;/b&gt; (a chat model)&lt;br&gt;Responses API, v1 route" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1F0FF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c8"><mxGeometry x="30" y="410" width="480" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Azure Container Apps: freshkart-insights (model key kept as a secret)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="560" height="400" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;A2A server&lt;/b&gt;&lt;br&gt;Agent Card at /.well-known/agent-card.json&lt;br&gt;public https address (PUBLIC_URL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c13"><mxGeometry x="30" y="50" width="500" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;SQL guard&lt;/b&gt;&lt;br&gt;one SELECT only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c13"><mxGeometry x="30" y="170" width="500" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;DuckDB over the gold Delta tables&lt;/b&gt;&lt;br&gt;built inside the image from the Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c13"><mxGeometry x="30" y="270" width="500" height="90" as="geometry"/></mxCell><mxCell id="c17" value="" styl