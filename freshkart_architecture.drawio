<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="p1" name="1 Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="FreshKart architecture overview: from messy files to an agent that reads only gold" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Lab numbers in the titles show where each part is built. Blue = sources, bronze/silver/gold = lakehouse layers, green = agent." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Sources (messy, Lab 0 and 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fontColor=#202124;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;POS sales&lt;/b&gt;&lt;br&gt;CSV, one row per order line&lt;br&gt;mixed dates, duplicates, returns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="c4"><mxGeometry x="20" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Web orders&lt;/b&gt;&lt;br&gt;JSON, items nested in each order&lt;br&gt;coupon, cancelled status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=1.5;fontColor=#202124;fontSize=12;align=center;